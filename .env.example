# PostgreSQL (used by docker-compose to configure the db service, and by
# the backend to build DATABASE_URL when running outside Docker)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=job_search_copilot

# Backend
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/job_search_copilot
CORS_ORIGINS=["http://localhost:5173"]

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
